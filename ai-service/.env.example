# Set to true only on your own machine to open the API docs at /docs
ENABLE_DOCS=false

# Optional override for the trained category model file.
# Defaults to models/category_model.joblib inside ai-service/.
CATEGORY_MODEL_PATH=

# Optional override for the pretrained Hugging Face emotion model.
# Defaults to lxyuan/distilbert-base-multilingual-cased-sentiments-student.
EMOTION_MODEL_NAME=

# Gemini free tier API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional override for the Gemini model used for suggested replies.
# Defaults to gemini-3.6-flash.
GEMINI_MODEL=

# Groq API key, from https://console.groq.com/keys - used for suggested
# replies only when Gemini fails or its free-tier quota is exhausted.
GROQ_API_KEY=

# Optional override for the Groq model used as the Gemini fallback.
# Defaults to openai/gpt-oss-120b.
GROQ_MODEL=

# Same MongoDB Atlas connection string as server/.env - used to look up
# similar past complaints for reply grounding.
MONGODB_URI=

# Shared secret so only the Express server can call POST /analyze.
# Generate with: openssl rand -hex 32
# Must match AI_SERVICE_KEY in server/.env.
AI_SERVICE_KEY=changeme
