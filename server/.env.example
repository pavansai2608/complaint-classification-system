# Port the Express server listens on
PORT=4000

# The only browser origin allowed to call this API (the React app)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string. Get your real one from Atlas > Connect > Drivers,
# and put the actual value in .env (never in this file, never committed).
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/complaint_system?retryWrites=true&w=majority

# Secrets used to sign JWTs. Must be long random strings, and different from
# each other. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=changeme
JWT_REFRESH_SECRET=changeme

# How long tokens stay valid
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Google Sign-In. Get this from Google Cloud Console > APIs & Services >
# Credentials > Create Credentials > OAuth client ID (type: Web application).
# Only the Client ID goes here — this flow verifies a token Google already
# signed, so no client secret is needed on the server.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Base URL of the ai-service (no trailing path, no trailing slash).
AI_SERVICE_URL=http://localhost:8000

# Shared secret sent as X-Service-Key to the ai-service.
# Must match AI_SERVICE_KEY in ai-service/.env.
AI_SERVICE_KEY=changeme

# How long to wait for the ai-service before giving up and saving the
# complaint anyway with a default priority.
AI_SERVICE_TIMEOUT_MS=5000
