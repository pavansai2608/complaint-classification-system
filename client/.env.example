# Google Sign-In. Same value as the server's GOOGLE_CLIENT_ID — Client IDs
# are public identifiers, safe to expose to the browser (unlike a secret).
# Get it from Google Cloud Console > APIs & Services > Credentials.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Support contact shown in the page footer. A public address, not a secret.
VITE_SUPPORT_EMAIL=support@example.com
