# Where the React app is running
CLIENT_BASE_URL=http://localhost:5173

# Where the Express API is running (used to check it is up before the tests start)
SERVER_BASE_URL=http://localhost:4000

# Set to false to watch the browser while a test runs
E2E_HEADLESS=true

# Seconds to wait for a page or element before a test fails
E2E_TIMEOUT=10
